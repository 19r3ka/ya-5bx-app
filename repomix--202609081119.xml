        function increment() {
            if (ageValue < 99) {
                ageValue++;
                updateDisplay();
            }
        }

        function decrement() {
            if (ageValue > 14) {
                ageValue--;
                updateDisplay();
            }
        }

        function updateDisplay() {
            display.textContent = ageValue;
            // Add a little pop animation
            display.classList.add('scale-110');
            setTimeout(() => display.classList.remove('scale-110'), 150);
        }

        // Horizontal touch targets improvement for mobile
        let startX = 0;
        document.addEventListener('touchstart', e => startX = e.touches[0].clientX);
        document.addEventListener('touchend', e => {
            const endX = e.changedTouches[0].clientX;
            if (startX - endX > 50) increment();
            if (endX - startX > 50) decrement();
        });
    </script>

        let reps = 10;
        const repCountEl = document.getElementById('rep-count');
        const logRepTextEl = document.getElementById('log-rep-text');

        function updateRepDisplay() {
            repCountEl.innerText = reps;
            logRepTextEl.innerText = reps;
            
            // Micro-interaction
            repCountEl.classList.remove('scale-110');
            void repCountEl.offsetWidth; // trigger reflow
            repCountEl.classList.add('transition-transform', 'duration-100', 'scale-110');
            setTimeout(() => repCountEl.classList.remove('scale-110'), 100);
        }

        function incrementReps() {
            reps++;
            updateRepDisplay();
        }

        function decrementReps() {
            if (reps > 0) {
                reps--;
                updateRepDisplay();
            }
        }

        // Mock Timer Logic
        let totalSeconds = 107; // 01:47
        const timerEl = document.getElementById('main-timer');

        setInterval(() => {
            if(totalSeconds > 0) {
                totalSeconds--;
                const mins = Math.floor(totalSeconds / 60);
                const secs = totalSeconds % 60;
                timerEl.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            }
        }, 1000);
    </script>

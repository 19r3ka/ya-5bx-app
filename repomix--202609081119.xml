<file path="src/components/WorkoutCard.vue">
<template>
  <v-card class="workout-card pa-4">
    <v-card-title class="text-h5">
      {{ $t('workoutCard.title') }}
    </v-card-title>

    <v-card-text v-if="hasValidLevel">
      <v-row>
        <v-col cols="12" md="7" lg="8">
          <v-card class="exercise-info-card py-4 mb-4">
            <v-row align="stretch" justify="center">
              <v-col cols="4">
                <ExerciseCard :exercise="currentExercise" />
              </v-col>
              <v-col cols="8">
                <div class="exercise-details">
                  <v-card-title>
                    {{ currentExerciseName }}
                  </v-card-title>
                  <v-card-text>
                    {{ currentExerciseDescription }}
                  </v-card-text>
                </div>
              </v-col>
            </v-row>
          </v-card>
        </v-col>

        <v-col cols="12" md="5" lg="4">
          <WorkoutTimer />
        </v-col>
      </v-row>
    </v-card-text>
    <v-card-text v-else>
      <div class="text-center">
        <p>You need to set your current level to start a workout.</p>
        <p>Please go to your profile to set your level.</p>
      </div>
    </v-card-text>

    <PostWorkoutDialog
      v-if="completedToken"
      v-model="showSummaryDialog"
      :session-token="completedToken"
    />

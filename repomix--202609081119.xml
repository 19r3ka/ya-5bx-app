<script setup lang="ts">
  import { useProgressionStore } from '../stores/useProgressionStore'

  const store = useProgressionStore()

  const levelsOrder = [
    'D-',
    'D',
    'D+',
    'C-',
    'C',
    'C+',
    'B-',
    'B',
    'B+',
    'A-',
    'A',
    'A+',

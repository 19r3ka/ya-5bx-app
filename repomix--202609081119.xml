<script>
        function togglePanel(button) {
            const container = button.parentElement;
            const isExpanded = container.classList.contains('expanded');
            
            // Optional: Close other panels
            /*
            document.querySelectorAll('.expanded').forEach(el => {
                if (el !== container) {
                    el.classList.remove('expanded');
                    el.classList.remove('border-primary');
                    el.classList.add('border-surface-variant');
                }
            });
            */

            if (isExpanded) {
                container.classList.remove('expanded');
                container.classList.remove('border-primary');
                container.classList.add('border-surface-variant');
                button.classList.remove('bg-surface-elevated');
            } else {
                container.classList.add('expanded');
                container.classList.add('border-primary');
                container.classList.remove('border-surface-variant');
                button.classList.add('bg-surface-elevated');
            }
        }

        // Initialize state for the expanded one
        window.addEventListener('DOMContentLoaded', () => {
            const radioLabels = document.querySelectorAll('input[type="radio"]');
            radioLabels.forEach(radio => {
                radio.addEventListener('change', (e) => {
                    // Visual feedback for selection
                    document.querySelectorAll('label').forEach(l => {
                        l.classList.remove('border-outline-variant');
                        l.classList.add('border-outline-variant/30');
                        l.querySelector('.material-symbols-outlined').classList.replace('text-secondary', 'text-text-tertiary');
                    });
                    const label = e.target.closest('label');
                    label.classList.add('border-outline-variant');
                    label.classList.remove('border-outline-variant/30');
                    label.querySelector('.material-symbols-outlined').classList.replace('text-text-tertiary', 'text-secondary');
                });
            });
        });
    </script>

<file path="src/core/scratch/generate_matrix.js">
import fs from 'fs'
import path from 'path'

const charts = {}
const levelsList = [
  'D-',
  'D',
  'D+',
  'C-',
  'C',
  'C+',
  'B-',
  'B',
  'B+',
  'A-',
  'A',
  'A+',
]

for (let chart = 1; chart <= 6; chart++) {
  charts[chart] = {}
  for (let idx = 0; idx < levelsList.length; idx++) {
    const lvl = levelsList[idx]
    charts[chart][lvl] = {
      exercise_1_reps: chart * 2 + idx + 2,
      exercise_2_reps: chart * 2 + idx + 3,
      exercise_3_reps: chart * 2 + idx + 4,
      exercise_4_reps: chart * 2 + idx + 1,
      exercise_5_stationary_steps: 100 + chart * 50 + idx * 25,
      outdoor_run_target_minutes: 15 - chart + idx * 0.5,
      walk_target_minutes: 30 - chart * 2 + idx,
    }
  }
}

const dir = './src/core/data'
if (!fs.existsSync(dir)) {
  fs.mkdirSync(dir, { recursive: true })
}

fs.writeFileSync(
  path.join(dir, 'charts_matrix.json'),
  JSON.stringify(charts, null, 2)
)
console.log('Successfully generated charts_matrix.json')
</file>

<file path="src/core/McMasterHIITStrategy.ts">
import type {
  IWorkoutStrategy,
  WorkoutGenerationContext,
  WorkoutInterval,
} from './EngineTypes'
import exerciseDictionaryJson from './data/exercise_dictionary.json'
import exerciseSubstitutionsJson from './data/exercise_substitutions.json'

// Compile-Time Nominal Key Validation
type MasterExerciseKey = keyof typeof exerciseDictionaryJson
type SubstitutionKey = keyof typeof exerciseSubstitutionsJson

// Compile-time check asserting every key in exerciseSubstitutions matches master exercise dictionary
type ValidateKeys<T extends MasterExerciseKey> = T
type CheckedSubstitutionKeys = ValidateKeys<SubstitutionKey>

export class McMasterHIITStrategy implements IWorkoutStrategy {
  public generateWorkout(context: WorkoutGenerationContext): WorkoutInterval[] {
    const intervals: WorkoutInterval[] = []

    // Look up substitutions matrix
    const substitutions: Record<string, string> = exerciseSubstitutionsJson

    const getExerciseKey = (key: CheckedSubstitutionKeys): string => {
      if (
        context.isModernSafeMode ||
        (context.profile.age && context.profile.age >= 60)
      ) {
        return substitutions[key] || key
      }
      return key
    }

    const activeKey = getExerciseKey('mcmaster_active')
    const recoveryKey = getExerciseKey('mcmaster_recovery')

    const activeDict = exerciseDictionaryJson[activeKey as MasterExerciseKey]
    const recoveryDict =
      exerciseDictionaryJson[recoveryKey as MasterExerciseKey]

    // 9-block matrix: 5 active work intervals (60s) interleaved with 4 walking recovery intervals (60s)
    // Sequence: Active (1), Recovery (1), Active (2), Recovery (2), Active (3), Recovery (3), Active (4), Recovery (4), Active (5)
    // Total sequence duration: 5 * 60 + 4 * 60 = 540 seconds.
    for (let i = 0; i < 5; i++) {
      intervals.push({
        exerciseId: activeKey,
        durationSeconds: 60,
        displayName: activeDict?.displayName || 'HIIT Active Work',
        description: `High Intensity Interval ${i + 1} of 5 (60s)`,
        translationKey: activeDict?.translationKey,
      })

      if (i < 4) {
        intervals.push({
          exerciseId: recoveryKey,
          durationSeconds: 60,
          displayName: recoveryDict?.displayName || 'HIIT Recovery',
          description: `Walking Recovery Interval ${i + 1} of 4 (60s)`,
          translationKey: recoveryDict?.translationKey,
        })
      }
    }

    return intervals
  }
}
</file>

<file path="src/core/ProgressionValidator.ts">
import type {
  UserProfile,
  LevelHistorySnapshot,
  ValidationResult,
} from './EngineTypes'
import progressionRulesJson from './data/progression_rules.json'

interface ProgressionRule {
  ageMin?: number
  ageMax?: number
  requiredSessions: number
}

const progressionRules: ProgressionRule[] =
  progressionRulesJson as ProgressionRule[]

export class ProgressionValidator {
  public validate(
    profile: UserProfile,
    snapshot: LevelHistorySnapshot
  ): ValidationResult {
    const age = profile.age

    if (age < 0 || isNaN(age)) {
      return {
        isEligible: false,
        reasonCode: 'INVALID_AGE',
        requiredSessions: 0,
        remainingSessions: 0,
      }
    }

    // Find the matching progression rule based on age
    const rule = progressionRules.find((r: ProgressionRule): boolean => {
      const minAge = r.ageMin ?? -Infinity
      const maxAge = r.ageMax ?? Infinity
      return age >= minAge && age <= maxAge
    })

    if (!rule) {
      return {
        isEligible: false,
        reasonCode: 'INVALID_AGE',
        requiredSessions: 0,
        remainingSessions: 0,
      }
    }

    let required = rule.requiredSessions
    if (snapshot.userFlaggedStiffOrSore) {
      required += 1
    }

    const completed = snapshot.verifiedCompletedSessionsAtCurrentLevel
    const remaining = Math.max(0, required - completed)

    if (snapshot.userFlaggedStiffOrSore) {
      return {
        isEligible: false,
        reasonCode: 'USER_TELEMETRY_RESTRICTION',
        requiredSessions: required,
        remainingSessions: remaining,
      }
    }

    if (remaining > 0) {
      return {
        isEligible: false,
        reasonCode: 'VOLUME_QUOTA_INCOMPLETE',
        requiredSessions: required,
        remainingSessions: remaining,
      }
    }

    return {
      isEligible: true,
      reasonCode: 'ELIGIBLE',
      requiredSessions: required,
      remainingSessions: 0,
    }
  }
}

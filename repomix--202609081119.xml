<file path="src/stores/useProgressionStore.ts">
import { defineStore } from 'pinia'
import { ref, shallowRef, computed } from 'vue'
import type { CompletedSessionRecord } from '../core/StorageTypes'
import { IndexedDBAdapter } from '../core/storage/IndexedDBAdapter'
import { TelemetryService } from '../core/telemetry/TelemetryService'
import { HistoryAggregator } from '../core/storage/HistoryAggregator'
import { ProgressionValidator } from '../core/ProgressionValidator'
import type {
  UserProfile,
  LevelHistorySnapshot,
  ValidationResult,
} from '../core/EngineTypes'

export const useProgressionStore = defineStore('progression', () => {
  const adapter = new IndexedDBAdapter()
  const telemetryService = new TelemetryService(adapter)
  const validator = new ProgressionValidator()

  const isHydrated = ref(false)
  const rawHistory = shallowRef<CompletedSessionRecord[]>([])

  const currentChart = ref(1)
  const currentLevel = ref('D-')
  const userProfile = ref<UserProfile>({ age: 30 })

  const initAsync = async (): Promise<void> => {
    await adapter.openAsync()
    const history = await adapter.getAllSessionsAsync()
    rawHistory.value = history
    isHydrated.value = true
  }

  const reloadHistoryAsync = async (): Promise<void> => {
    const history = await adapter.getAllSessionsAsync()
    rawHistory.value = history
  }

  const validationResult = computed<ValidationResult | null>(() => {
    if (!isHydrated.value) {
      return null
    }

    const contiguousVolume = HistoryAggregator.calculateContiguousVolume(
      rawHistory.value,
      currentChart.value,
      currentLevel.value
    )

    // Check if the last completed session flagged stiff/sore
    const lastSession = rawHistory.value[rawHistory.value.length - 1]
    const userFlaggedStiffOrSore = lastSession?.userFlaggedStiffOrSore ?? false

    const snapshot: LevelHistorySnapshot = {
      currentChart: currentChart.value,
      currentLevel: currentLevel.value,
      verifiedCompletedSessionsAtCurrentLevel: contiguousVolume,
      userFlaggedStiffOrSore,
    }

    return validator.validate(userProfile.value, snapshot)
  })

  return {
    isHydrated,
    rawHistory,
    currentChart,
    currentLevel,
    userProfile,
    initAsync,
    reloadHistoryAsync,
    validationResult,
    adapter,
    telemetryService,
  }
})
</file>

<file path="src/stores/useUserStore.ts">
import { defineStore } from 'pinia'
import {
  STORAGE_KEY_ONBOARDING_DRAFT,
  LOCALSTORAGE_USER_KEY,
} from '@/constants'

export interface UserProfile {
  name?: string
  dob?: Date | string
  age?: number
  currentLevel?: string
  goalLevel?: string
  isOnboardingCompleted: boolean
}

export const useUserStore = defineStore('user', {
  state: () => {
    let savedDraft = { step: 1, age: null as number | null, aerobic: 'run' }
    try {
      const draftStr = localStorage.getItem(STORAGE_KEY_ONBOARDING_DRAFT)
      if (draftStr) {
        const parsed = JSON.parse(draftStr)
        savedDraft = {
          step: parsed.step ?? parsed.currentStep ?? 1,
          age: parsed.age ?? null,
          aerobic: parsed.aerobic ?? 'run',
        }
      }
    } catch {
      // ignore
    }

    let savedProfile: UserProfile | null = null
    try {
      const userStr = localStorage.getItem(LOCALSTORAGE_USER_KEY)
      if (userStr) {
        const parsed = JSON.parse(userStr)
        savedProfile = {
          ...parsed,
          isOnboardingCompleted: parsed.isOnboardingCompleted ?? true,
        }
      }
    } catch {
      // ignore
    }

    return {
      profile: savedProfile as UserProfile | null,
      draftStep: savedDraft.step,
      draftAge: savedDraft.age,
      draftAerobic: savedDraft.aerobic,
    }
  },
  actions: {
    persistDraft() {
      localStorage.setItem(
        STORAGE_KEY_ONBOARDING_DRAFT,
        JSON.stringify({
          step: this.draftStep,
          currentStep: this.draftStep,
          age: this.draftAge,
          aerobic: this.draftAerobic,
        })
      )
    },
    setDraftStep(step: number) {
      this.draftStep = step
      this.persistDraft()
    },
    setDraftAge(age: number) {
      this.draftAge = age
      this.persistDraft()
    },
    setDraftAerobic(val: string) {
      this.draftAerobic = val
      this.persistDraft()
    },
    completeOnboarding(profileData?: Partial<UserProfile>) {
      this.profile = {
        isOnboardingCompleted: true,
        ...profileData,
      }
      localStorage.setItem(LOCALSTORAGE_USER_KEY, JSON.stringify(this.profile))
      localStorage.removeItem(STORAGE_KEY_ONBOARDING_DRAFT)
    },
  },
})
</file>


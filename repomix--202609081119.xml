        function selectOption(choice) {
            const btnGreat = document.getElementById('btn-great');
            const btnSore = document.getElementById('btn-sore');
            const checkGreat = document.getElementById('check-great');
            const checkSore = document.getElementById('check-sore');
            const followUp = document.getElementById('follow-up');

            // Reset states
            btnGreat.classList.remove('toggle-active-primary');
            btnSore.classList.remove('toggle-active-surface');
            checkGreat.classList.add('opacity-0');
            checkSore.classList.add('opacity-0');
            followUp.classList.add('hidden');

            // Set active state
            if (choice === 'great') {
                btnGreat.classList.add('toggle-active-primary');
                checkGreat.classList.remove('opacity-0');
            } else {
                btnSore.classList.add('toggle-active-surface');
                checkSore.classList.remove('opacity-0');
                followUp.classList.remove('hidden');
            }
            
            // Haptic feedback simulation
            if (window.navigator.vibrate) {
                window.navigator.vibrate(10);
            }
        }

        // Timer Logic
        let seconds = 10;
        const timerText = document.getElementById('timer-text');
        const countdown = setInterval(() => {
            seconds--;
            if (seconds >= 0) {
                timerText.innerText = seconds;
            }
            if (seconds === 0) {
                clearInterval(countdown);
                // Trigger auto-save visual feedback
                document.getElementById('progress-bar').style.backgroundColor = '#4CAF50';
            }
        }, 1000);
    </script>
